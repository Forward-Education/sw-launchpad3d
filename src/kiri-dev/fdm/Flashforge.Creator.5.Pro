        "; EXECUTABLE_BLOCK_START",
        "M73 P0 R5",
        "M106 S0",
        "M106 P2 S0",
        ";TYPE:Custom",
        "M140 S{bed_temp}",
        "; preheat each toolhead that is used in this print",
        "M104 T0 S{temp}",
        ";; IF { tool_used_1 }",
        "M104 T1 S{temp}",
        ";; END",
        ";; IF { tool_used_2 }",
        "M104 T2 S{temp}",
        ";; END",
        ";; IF { tool_used_3 }",
        "M104 T3 S{temp}",
        ";; END",
