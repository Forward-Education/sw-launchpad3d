        "G28 ; home all axes",
        "T0 ; pick up first toolhead",
        "M109 T0 S{temp}",
        "G90",
        "M83 ; relative extrusion",
        "G21",
        "SET_PRESSURE_ADVANCE ADVANCE=0.025",
        "G1 Z5 F6000",
        "G1 E-0.2 F800",
        "G1 X50 Y256 Z0.25 F4800",
        "G1 E2 F800",
        "G1 X70 E8 F2400",
        "G1 X236 E10 F2400",
        "G0 Y255.6",
        "G1 X146 E5 F2400",
        "G92 E0",
        "M106 S0",
        "M106 P2 S0"
    ],
    "gcodePost": [
        "M107",
        "M106 S0",
        "M106 P2 S0",
        ";TYPE:Custom",
        "M104 S0 T0",
        ";; IF { tool_used_1 }",
        "M104 S0 T1",
        ";; END",
        ";; IF { tool_used_2 }",
        "M104 S0 T2",
        ";; END",
        ";; IF { tool_used_3 }",
        "M104 S0 T3",
        ";; END",
        "M140 S0",
        "G1 E-3 F3600",
        "G28 X Y ; park",
        "M73 P100 R0",
        "; EXECUTABLE_BLOCK_END"
