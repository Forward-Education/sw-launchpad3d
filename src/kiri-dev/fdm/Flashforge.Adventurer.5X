{
    "mode": "FDM",
    "device-image": "img/ad5x.png",
    "internal": 0,
    "bedHeight": 2.5,
    "bedWidth": 220,
    "bedDepth": 220,
    "bedRound": false,
    "bedBelt": false,
    "deviceZMax": 0,
    "gcodeTime": 1,
    "maxHeight": 220,
    "originCenter": false,
    "gcodeFan": [
        "M106 S{fan_speed}"
    ],
    "gcodeFeature": [],
    "gcodeTrack": [],
    "gcodeLayer": [
        ";LAYER_CHANGE {layer} of {layers}",
        ";; IF { layer === 0 }",
        "SET_VELOCITY_LIMIT ACCEL=500",
        ";; ELSE",
        "SET_VELOCITY_LIMIT ACCEL=10000",
        ";; END"
    ],
    "gcodePre": [
        "; HEADER_BLOCK_START",
        "; FlashForge Adventurer 5X - single nozzle, 4-color filament station (CFS)",
        "; total layer number: {layers}",
        "; max_z_height: {z_max}",
        "; filaments in use (tool count): {tool_count}",
        "; NOTE: color changes rely on Kiri purge block + load/unload macros;",
        ";       this is NOT OrcaSlicer's wipe tower. Validate purge volume on machine.",
        "; HEADER_BLOCK_END",
        "; EXECUTABLE_BLOCK_START",
        "M73 P0 R5",
        "M106 S0",
        "M106 P2 S0",
        ";TYPE:Custom",
        "M190 S{bed_temp}",
        "M104 S{temp}",
        "G90",
        "M83",
        "G1 Z2 F6000",
        "G1 X50 Y220 Z0.25 F4800",
        "G1 X70 E3 F900",
        "G1 X200 E10 F1800",
        "G0 Y219.6",
        "G1 X130 E5 F1800",
        "G92 E0",
        "G90",
        "G21",
        "M83 ; use relative distances for extrusion",
        "SET_PRESSURE_ADVANCE ADVANCE=0.025",
        "T0",
        "M106 S0",
        "M106 P2 S0"
    ],
    "gcodePost": [
        "M107",
        "G1 E-2 F2700",
        "M106 S0",
        "M106 P2 S0",
        ";TYPE:Custom",
        "; filament end gcode",
        "G1 E-3 F3600",
        "G0 X50 Y50 F30000",
        "M104 S0 ; turn off temperature",
        "M140 S0",
        "M73 P100 R0",
        "; EXECUTABLE_BLOCK_END"
    ],
    "gcodeProc": "",
    "gcodeChange": [],
    "gcodeFExt": "gcode",
    "extruders": [
        {
            "extFilament": 1.75,
            "extNozzle": 0.4,
            "extSelect": ["; CP TOOLCHANGE START -> T0", "M104 S{temp}", "T0", "; filament start gcode", "SET_PRESSURE_ADVANCE ADVANCE=0.025", "G1 E5 F2700 ; load", "G92 E0"],
            "extDeselect": ["; CP TOOLCHANGE UNLOAD", "G1 E-5 F2700 ; unload"],
            "extOffsetX": 0,
            "extOffsetY": 0
        },
        {
            "extFilament": 1.75,
            "extNozzle": 0.4,
            "extSelect": ["; CP TOOLCHANGE START -> T1", "M104 S{temp}", "T1", "; filament start gcode", "SET_PRESSURE_ADVANCE ADVANCE=0.025", "G1 E5 F2700 ; load", "G92 E0"],
            "extDeselect": ["; CP TOOLCHANGE UNLOAD", "G1 E-5 F2700 ; unload"],
            "extOffsetX": 0,
            "extOffsetY": 0
        },
        {
            "extFilament": 1.75,
            "extNozzle": 0.4,
            "extSelect": ["; CP TOOLCHANGE START -> T2", "M104 S{temp}", "T2", "; filament start gcode", "SET_PRESSURE_ADVANCE ADVANCE=0.025", "G1 E5 F2700 ; load", "G92 E0"],
            "extDeselect": ["; CP TOOLCHANGE UNLOAD", "G1 E-5 F2700 ; unload"],
            "extOffsetX": 0,
            "extOffsetY": 0
        },
        {
            "extFilament": 1.75,
            "extNozzle": 0.4,
            "extSelect": ["; CP TOOLCHANGE START -> T3", "M104 S{temp}", "T3", "; filament start gcode", "SET_PRESSURE_ADVANCE ADVANCE=0.025", "G1 E5 F2700 ; load", "G92 E0"],
            "extDeselect": ["; CP TOOLCHANGE UNLOAD", "G1 E-5 F2700 ; unload"],
            "extOffsetX": 0,
            "extOffsetY": 0
        }
    ],
    "new": false,
    "deviceName": "Flashforge Adventurer 5X",
    "imageURL": "",
    "fwRetract": false,
    "filamentSource": "direct",
    "profiles": [
        {
            "processName": "Standard PLA Multi-Color",
            "sliceHeight": 0.2,
            "sliceShells": 3,
            "sliceShellOrder": "out-in",
            "sliceLayerStart": "last",
            "sliceFillAngle": 45,
